# ============================================================
# go-stock Python 版 —— 本地开发环境变量模板
# 使用方式：复制本文件为 .env 并填写真实配置
#   cp .env.example .env
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# SQLite（默认，本地开发推荐，无需额外安装）
DATABASE_URL=sqlite+aiosqlite:///./go_stock.db

# PostgreSQL（可选，本地开发也可以用）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/go_stock

# ── Redis ───────────────────────────────────────────────────
# Docker Compose 环境下
REDIS_URL=redis://redis:6379/0
# 本地直接开发时使用
# REDIS_URL=redis://localhost:6379/0

# ── AI 模型配置 ──────────────────────────────────────────────
# API 密钥（必填）
AI_API_KEY=your_api_key_here

# API 基础 URL
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com
# Ollama本地: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
# OpenAI: gpt-4o, gpt-4o-mini
# DeepSeek: deepseek-chat
# Ollama: llama3.2, qwen2.5
AI_MODEL_NAME=gpt-4o

# Embedding 模型配置（OpenAI 兼容 /v1/embeddings 接口）
# bge-m3 通常为 1024 维，需与 rag_chunk_embeddings.embedding_vector 的 VECTOR(1024) 保持一致
AI_EMBEDDING_API_KEY=your_embedding_api_key_here
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_BATCH_SIZE=32

# RAG 新闻流水线配置
# 新闻定时任务有新增数据时，自动执行 新闻同步 -> 切片 -> 向量化
RAG_PIPELINE_ON_NEWS_CRAWL=true
RAG_PIPELINE_MIN_INTERVAL_SECONDS=60
RAG_PIPELINE_NEWS_LIMIT=100
RAG_PIPELINE_CHUNK_LIMIT=100
RAG_PIPELINE_EMBED_LIMIT=100
RAG_PIPELINE_MAX_CHARS=800
RAG_PIPELINE_OVERLAP_CHARS=120

# ── 应用基本配置 ─────────────────────────────────────────────
DEBUG=true
APP_NAME=python-stock
SECRET_KEY=your-secret-key-here-change-in-production

# ── CORS 跨域配置 ────────────────────────────────────────────
# 多个来源用逗号分隔
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Tushare Token（可选，用于获取基础数据） ─────────────────────
TUSHARE_TOKEN=your_tushare_token_here
