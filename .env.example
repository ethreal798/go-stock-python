# ============================================================
# go-stock Python 版 —— 环境变量模板
# 使用方式：复制本文件为 .env 并填写真实配置
#   cp .env.example .env
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# SQLite（默认，开发推荐）
DATABASE_URL=sqlite+aiosqlite:///./go_stock.db

# PostgreSQL（生产推荐，取消注释并填写）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/go_stock

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# 本地开发时使用：
# REDIS_URL=redis://localhost:6379/0

# ── AI 模型配置 ──────────────────────────────────────────────
# API 密钥（必填）
AI_API_KEY=your-api-key-here

# API 基础 URL
# DeepSeek:  https://api.deepseek.com
# OpenAI:    https://api.openai.com/v1
# 本地 Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com

# 模型名称
# DeepSeek: deepseek-chat / deepseek-reasoner
# OpenAI:   gpt-4o / gpt-4o-mini
# Ollama:   llama3.2 / qwen2.5
AI_MODEL_NAME=deepseek-chat

# AI 请求超时（秒）
AI_TIMEOUT=120

# ── 应用基本配置 ─────────────────────────────────────────────
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 应用密钥（生产环境请替换为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── CORS 跨域配置 ────────────────────────────────────────────
# 多个来源用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# ── 钉钉预警 ────────────────────────────────────────────────
DINGDING_WEBHOOK_URL=
DINGDING_SECRET=

# ── 日志配置 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
# DEBUG / INFO / WARNING / ERROR / CRITICAL

# ── 股票数据源 ───────────────────────────────────────────────
# 东方财富数据接口（默认启用）
EASTMONEY_ENABLED=true

# Tushare Token（可选，用于获取基础数据）
TUSHARE_TOKEN=

# ── 爬虫配置 ─────────────────────────────────────────────────
# 请求超时（秒）
CRAWLER_TIMEOUT=30
# 最大并发数
CRAWLER_MAX_CONCURRENCY=5

# ── 定时任务 ─────────────────────────────────────────────────
# 股票数据刷新间隔（秒），0 表示禁用
STOCK_REFRESH_INTERVAL=30
# 预警检查间隔（秒）
ALERT_CHECK_INTERVAL=60
