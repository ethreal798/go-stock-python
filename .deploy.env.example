# ============================================================
# 生产环境部署配置示例
# 使用方式：复制本文件为 .deploy.env 并填写真实配置
# ============================================================

# Docker 镜像配置
BACKEND_IMAGE=ghcr.io/your-username/your-repo-backend:latest
FRONTEND_IMAGE=ghcr.io/your-username/your-repo-frontend:latest

# PostgreSQL 配置（被 docker-compose.prod.yml 使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=go_stock

# ============================================================
# 重要：DATABASE_URL 的主机名必须是 docker-compose.prod.yml 中的服务名 "postgres"
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/go_stock

# Redis 配置（主机名必须是 "redis"）
REDIS_URL=redis://redis:6379/0

# 应用配置
DEBUG=false
SECRET_KEY=your_secure_secret_key_here_make_it_long_and_random

# AI 模型配置
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o

# CORS 配置（允许的前端域名）
CORS_ORIGINS_STR=https://your-domain.com,http://your-domain.com
